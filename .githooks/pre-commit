#!/bin/sh
# 阻止把本机 .env、API key、私钥提交进仓库。
set -u
failed=0

staged_env=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env$' || true)
if [ -n "$staged_env" ]; then
    echo "BLOCKED: 暂存区里有本机 .env 文件：" >&2
    echo "$staged_env" >&2
    failed=1
fi

hits=$(git diff --cached -U0 --diff-filter=ACMR | grep -nE 'sk-[A-Za-z0-9]{24,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' || true)
if [ -n "$hits" ]; then
    echo "BLOCKED: 暂存内容里疑似 API key / 私钥：" >&2
    echo "$hits" | head -5 >&2
    failed=1
fi

if [ "$failed" -ne 0 ]; then
    echo "提交已阻止。确认无误后可用 git commit --no-verify 跳过（不建议）。" >&2
    exit 1
fi
exit 0
