OPENAI_API_KEY=sk-xxx
# Optional: compatible endpoint (Azure / proxy / local vLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o
# Optional separate model for independent code review; defaults to AGENT_MODEL.
# AGENT_REVIEW_MODEL=gpt-4.1
# Source tree the agent is allowed to read (defaults to the repository containing agent/).
AGENT_REPO_ROOT=..
# Optional override for LangGraph's SQLite conversation state.
# AGENT_CHECKPOINT_DB=/path/to/agent-checkpoints.sqlite
# Optional argv-style build command. {mode} is debug|release and {build_type} is Debug|Release.
# Default configures and builds in build-agent-{mode}, leaving existing build directories alone.
# Example: AGENT_BUILD_CMD=cmake --build build --parallel 4
# Do not use shell operators; the command is parsed as argv and run without a shell.
